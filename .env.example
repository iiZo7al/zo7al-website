# Server-only secrets. Never use NEXT_PUBLIC_ prefixes.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Generate a random secret: openssl rand -hex 32
SPACE_RUN_SECRET=

# Tebex Headless API (webstore catalog and checkout)
TEBEX_PUBLIC_TOKEN=
TEBEX_PRIVATE_KEY=
# Optional game-server API secret, required to verify active package ownership.
TEBEX_PLUGIN_SECRET=

# Creator applications, support, events and checkout notifications (Discord)
DISCORD_APPLICATION_WEBHOOK_URL=
# Optional destinations; fall back to DISCORD_APPLICATION_WEBHOOK_URL
DISCORD_SUPPORT_WEBHOOK_URL=
DISCORD_EVENT_WEBHOOK_URL=

# Hidden administration. Generate with scripts/generate-admin-secrets.mjs.
ZO7AL_ADMIN_PASSWORD_HASH=
ZO7AL_ADMIN_SESSION_SECRET=

# Optional Google OAuth app; otherwise configure it in the dashboard.
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=

# Optional trusted Minecraft server bridges. HTTPS only.
MINECRAFT_PROFILE_URL=
MINECRAFT_PROFILE_TOKEN=
MINECRAFT_ORDER_STATUS_URL=
